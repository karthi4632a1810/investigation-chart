PORT=2003

# Login for the app's own UI (POST /api/login). config.js defaults these to
# admin/admin123 when unset — that default is fine for local dev only. Set
# real values before deploying anywhere reachable from the internet.
APP_USERNAME=REPLACE_ME
APP_PASSWORD=REPLACE_ME

# Internal Docker-network addresses — docker-compose.yml already sets these
# for the containers, this file only matters if you run the server directly
# on the host instead of via Compose.
MONGO_URI=mongodb://localhost:3003
MONGO_DB=investigation-chart

MINIO_ENDPOINT=localhost
MINIO_PORT=4003
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=REPLACE_ME
MINIO_SECRET_KEY=REPLACE_ME
MINIO_BUCKET=investigation-reports
# Must match MINIO_PUBLIC_ENDPOINT in the root .env.production.example.
MINIO_PUBLIC_ENDPOINT=194.238.22.210
MINIO_PUBLIC_PORT=4003

# The frontend proxies /api through its own nginx, so browser requests are
# same-origin and this is mostly moot — but pin it to the real origin anyway
# rather than leaving it wide open.
CORS_ORIGINS=http://194.238.22.210:1003

EMR_LOGIN_URL=https://emr.mapims.edu.in/BB15SE/wsLogin.asmx/chkLoginNew
EMR_LAB_URL_TEMPLATE=https://emr.mapims.edu.in/BB15SE/Lab/LabResultHis.aspx?action=Search&Orderid=
EMR_QUERY_BUILDER_URL=https://emr.mapims.edu.in/BB15SE/QueryBuilder/wsQueryBuilder.asmx/Getdataset1
EMR_BASE_URL=https://emr.mapims.edu.in/BB15SE

# EMR service account. Placeholders only — never commit real credentials.
EMR_USERNAME=REPLACE_ME
EMR_PASSWORD=REPLACE_ME
EMR_LOG_OPT=2

HOSPITAL_LOGO_PATH=https://mh.mapims.edu.in/static/images/logo.png
HOSPITAL_NAME_EN=Adhiparasakthi Hospitals
HOSPITAL_NAME_TA=ஆதிபராசக்தி மருத்துவமனை
HOSPITAL_ADDRESS=A clinical division of Melmaruvathur Adhiparasakthi Institute of Medical Sciences and Research<br>G.S.T. Road, Melmaruvathur - 603 319. Phone: 044-2752 8528. Toll Free: 1800 599 0999. Website: www.mapims.org
