PORT=2003

# Host/dev runs reach the Dockerized Mongo and MinIO via their published ports.
# docker-compose.yml overrides these with the internal service hostnames
# (mongo:3003, minio:4003) for the containers' own network — keep both in sync if
# you change the ports there.
MONGO_URI=mongodb://localhost:3003
MONGO_DB=investigation-chart

MINIO_ENDPOINT=localhost
MINIO_PORT=4003
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=investigation-reports
# Used only to build presigned PDF URLs handed to the browser — must be a host the
# *browser* can reach, not the Docker-internal "minio" hostname. "localhost" is
# correct when the browser and this stack are on the same machine; set this to the
# server's real hostname/IP otherwise.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=4003

# Browser origins allowed to make credentialed API calls. Empty/`*` is fine for the
# docker-compose setup (nginx serves the UI and proxies /api, so requests are
# same-origin and carry no Origin header). Add the Vite dev server here when
# running `npm run dev` with the UI on a different port.
CORS_ORIGINS=*

EMR_LOGIN_URL=https://emr.mapims.edu.in/BB15SE/wsLogin.asmx/chkLoginNew
EMR_LAB_URL_TEMPLATE=https://emr.mapims.edu.in/BB15SE/Lab/LabResultHis.aspx?action=Search&Orderid=
EMR_QUERY_BUILDER_URL=https://emr.mapims.edu.in/BB15SE/QueryBuilder/wsQueryBuilder.asmx/Getdataset1

# EMR service account. Placeholders only — never commit real credentials.
EMR_USERNAME=replace-me
EMR_PASSWORD=replace-me
EMR_LOG_OPT=2

HOSPITAL_LOGO_PATH=https://mh.mapims.edu.in/static/images/logo.png
HOSPITAL_NAME_EN=Adhiparasakthi Hospitals
HOSPITAL_NAME_TA=ஆதிபராசக்தி மருத்துவமனை
HOSPITAL_ADDRESS=A clinical division of Melmaruvathur Adhiparasakthi Institute of Medical Sciences and Research<br>G.S.T. Road, Melmaruvathur - 603 319. Phone: 044-2752 8528. Toll Free: 1800 599 0999. Website: www.mapims.org
