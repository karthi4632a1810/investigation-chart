# Root-level env, read by docker-compose.yml's ${VAR} substitution (not by any
# container directly). Copy to ".env" on the VPS and fill in real values —
# ".env" is gitignored, never commit the filled-in file.

# MinIO root credentials. "minioadmin"/"minioadmin" is the image's well-known
# default — generate real ones before going anywhere near a public IP:
#   openssl rand -base64 24
MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME

# Hostname/IP the *browser* uses to reach MinIO directly for presigned PDF
# downloads — must be reachable from wherever the browser actually is.
MINIO_PUBLIC_ENDPOINT=194.238.22.210
