# Root-level env, read by docker-compose.yml's ${VAR} substitution (not by any
# container directly). Copy to ".env" on the VPS and fill in real values —
# ".env" is gitignored, never commit the filled-in file.

# MinIO root credentials. "minioadmin"/"minioadmin" is the image's well-known
# default — generate real ones before going anywhere near a public IP:
#   openssl rand -base64 24
MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME

# Hostname/IP the *browser* uses to reach MinIO directly for presigned PDF
# downloads — must be reachable from wherever the browser actually is.
MINIO_PUBLIC_ENDPOINT=194.238.22.210

# Host-side port bindings — docker-compose.yml falls back to the plain "x003"
# ports (bound to all interfaces) if these are unset, which is fine on a
# dedicated/local box but NOT on a shared VPS already running other
# containers. CLIENT and MINIO_API stay public (the browser needs to reach
# them); SERVER, MONGO, and the MinIO console are loopback-only and moved off
# the default port numbers to dodge collisions with other apps on this box —
# adjust the loopback port numbers if these specific ones are ever taken too.
CLIENT_PORT_BIND=1003:80
SERVER_PORT_BIND=127.0.0.1:2033:2003
MONGO_PORT_BIND=127.0.0.1:3033:3003
MINIO_API_PORT_BIND=4003:4003
MINIO_CONSOLE_PORT_BIND=127.0.0.1:5033:5003
