      "yamlFiles": [
        {
          "name": "docker-compose.yml",
          "content": "services:\n  server:\n    build:\n      context: ./server\n      dockerfile: Dockerfile\n    container_name: patient-investigation-server\n    env_file:\n      - ./server/.env\n    environment:\n      PORT: 2000\n    ports:\n      - \"2000:2000\"\n    expose:\n      - \"2000\"\n    restart: unless-stopped\n    networks:\n      - app-network\n\n  client:\n    build:\n      context: ./client\n      dockerfile: Dockerfile\n    container_name: patient-investigation-client\n    ports:\n      - \"1000:80\"\n    depends_on:\n      - server\n    restart: unless-stopped\n    networks:\n      - app-network\n\nnetworks:\n  app-network:\n    driver: bridge\n"
        },
        {
          "name": "docker-compose.prod.yml",
          "content": "services:\n  server:\n    container_name: invest_server\n    ports:\n      - \"2000:2000\"\n    restart: unless-stopped\n\n  client:\n    container_name: invest_client\n    ports:\n      - \"1000:80\"\n    restart: unless-stopped\n"
        }
      ],
      "notes": [
        {
          "title": "Local Development",
          "content": "## Setup\n1. Copy `server/.env.example` → `server/.env` and set EMR credentials\n2. `npm run install:all`\n3. `npm run dev`\n\n- Frontend: http://localhost:5173 (proxies `/api` → `:2000`)\n- API: http://localhost:2000",
          "tag": "development"
        },
        {
          "title": "Docker Deploy (192.168.101.116)",
          "content": "## Deploy\n1. Clone/pull `production` into `~/investigation-chart`\n2. Ensure `server/.env` exists with real EMR credentials\n3. `sudo docker compose up --build -d`\n4. Open http://192.168.101.116:1000\n\n| Service | Port |\n|---------|------|\n| Frontend (nginx) | **1000** |\n| Backend (Express) | **2000** |\n\nClient nginx proxies `/api` → `server:2000` on the Docker network.",
          "tag": "deployment"
        },
        {
          "title": "Domain: invest.mapims.edu.in",
          "content": "## Host nginx\n1. Copy `deploy/nginx/invest.mapims.edu.in.conf` to `/etc/nginx/sites-available/`\n2. Enable site + `nginx -t` + reload\n3. Upstream points to `127.0.0.1:1000`\n4. Optional SSL: use `invest.mapims.edu.in.ssl.conf` after certbot\n\nA record should already point to the server.",
          "tag": "deployment"
        },
        {
          "title": "API Endpoints",
          "content": "- `GET /api/health`\n- `GET /api/config/hospital`\n- `POST /api/search` `{ regNo, fromDate, toDate }`\n- `GET /api/detail/:orderid`",
          "tag": "api"
        }
