# AI_FOR_AOSTRA — environment for the standalone "Ask AI" app
#
# Copy to the new app as `.env` and fill in every "replace-me" from the portal's
# server/.env on the server (/docker/investigation-chart/server/.env) or the
# root .env. NEVER commit the filled-in file. See AI_FOR_AOSTRA.md, sections 4 and 24.
#
# Option A (recommended): the new app shares the portal's MongoDB and MinIO on the
# same server — join the portal's Docker network (e.g. `investigation-chart_default`)
# and use the internal names below. Option B (fully independent): point these at
# the new app's own MongoDB / MinIO and also fill in the EMR and WATI webhook parts.

# ---- Server ---------------------------------------------------------------------
PORT=2005
# Browser origins allowed to call the API with cookies. Empty or * when the UI is
# served from the same origin (nginx proxying /api).
CORS_ORIGINS=*
# Chromium for HTML→PDF and the EMR discharge-summary page (Debian/Alpine image path).
CHROME_PATH=/usr/bin/chromium

# ---- Sign-in (if the app has accounts) --------------------------------------------
APP_USERNAME=admin
APP_PASSWORD=replace-me
# openssl rand -base64 32 — signs the session cookie (12 h sessions).
SESSION_SECRET=replace-me

# ---- MongoDB ------------------------------------------------------------------------
# Option A: the portal's Mongo on its Docker network (service "mongo", port 3003).
MONGO_URI=mongodb://mongo:3003
MONGO_DB=investigation-chart

# ---- MinIO (PDF storage) --------------------------------------------------------------
# Option A: the portal's MinIO on its Docker network (service "minio", port 4003).
MINIO_ENDPOINT=minio
MINIO_PORT=4003
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=investigation-reports
MINIO_REGION=
# Only used for presigned links handed to a browser when PUBLIC_BASE_URL is empty.
MINIO_PUBLIC_ENDPOINT=replace-me
MINIO_PUBLIC_PORT=4003
MINIO_PUBLIC_USE_SSL=false

# ---- Public PDF links sent on WhatsApp ------------------------------------------------
# The https address WhatsApp / WATI fetch the PDF from:
#   <PUBLIC_BASE_URL>/api/public/doc/<signed token>/<File>.pdf
PUBLIC_BASE_URL=https://replace-me.example
# MUST be the same value as the portal's PUBLIC_LINK_SECRET (it may start with "hex:")
# so links made by either app open in both. If the portal has none set yet, its key is
# derived from APP_PASSWORD — pin it first (the portal's scripts/reset-superadmin-password.sh
# does this), then copy it here.
PUBLIC_LINK_SECRET=replace-me
# How long a PDF link works (days, 1–7).
WHATSAPP_LINK_DAYS=2

# ---- AI providers (OpenAI-compatible chat APIs) ----------------------------------------
# Tried in order: every Groq model, then every Gemini model; the first that answers wins.
GROQ_API_KEY=replace-me
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CHAT_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# ---- Ask AI behaviour ---------------------------------------------------------------------
# on  = tool results go to the AI provider with patient details (needed for "her number",
#       "discharge time", "compare"); ABHA ID, religion and MLC are never sent.
# off = the AI only gets counts; cards still show everything on screen.
AI_SHARE_PATIENT_DATA=on
# New in the standalone app (Master Settings in the portal): EMR lab lookup range in days
# when the user gives no dates, and the discharge-check interval quoted in the prompt.
AI_LOOKUP_DAYS=30
DISCHARGE_CHECK_MINUTES=15

# ---- Hospital (letterhead on every PDF, name in the prompt) --------------------------------
HOSPITAL_NAME_EN=Adhiparasakthi Hospitals
HOSPITAL_NAME_TA=ஆதிபராசக்தி மருத்துவமனை
HOSPITAL_ADDRESS=A clinical division of Melmaruvathur Adhiparasakthi Institute of Medical Sciences and Research<br>G.S.T. Road, Melmaruvathur - 603 319. Phone: 044-2752 8528. Toll Free: 1800 599 0999. Website: www.mapims.org
HOSPITAL_LOGO_PATH=https://mh.mapims.edu.in/static/images/logo.png

# ---- EMR (needed for the OP / any-UHID lab lookup; also for ingestion in option B) ---------
EMR_BASE_URL=https://emr.mapims.edu.in/BB15SE
EMR_LOGIN_URL=https://emr.mapims.edu.in/BB15SE/wsLogin.asmx/chkLoginNew
EMR_LAB_URL_TEMPLATE=https://emr.mapims.edu.in/BB15SE/Lab/LabResultHis.aspx?action=Search&Orderid=
EMR_QUERY_BUILDER_URL=https://emr.mapims.edu.in/BB15SE/QueryBuilder/wsQueryBuilder.asmx/Getdataset1
EMR_RET_DATATABLE_URL=https://emr.mapims.edu.in/BB15SE/Lab/wsLabServices.asmx/RETDatatable
# EMR service account — copy from the portal; never commit.
EMR_USERNAME=replace-me
EMR_PASSWORD=replace-me
EMR_LOG_OPT=2

# ---- WhatsApp (WATI) ------------------------------------------------------------------------
# Tenant API host from WATI → API Docs, e.g. https://live-mt-server.wati.io/123456
API_ENDPOINT=replace-me
# The full "Bearer eyJ…" value from the same page (used as-is in the Authorization header).
WATI_ACCESS_TOKEN=replace-me
# Default report template: {{1}} name, {{2}} one line, {{3}} PDF URL.
WATI_TEMPLATE_ID=investigation
# New in the standalone app (WATI Settings in the portal): template for Ask AI lab lookups.
# mapims_lab_rpt = {{1}} name + {{attachmentLink}} PDF ("Your laboratory report is ready").
WATI_LAB_REPORT_TEMPLATE=mapims_lab_rpt
# Status checks for delivered / read ticks when no webhook is connected (WATI's monthly
# quota covers sends AND these reads — keep it low).
WATI_STATUS_CHECKS_PER_DAY=100
# Option B only (the portal receives the webhook in option A): secret part of
# <PUBLIC_BASE_URL>/api/public/wati-webhook/<WATI_WEBHOOK_KEY>. openssl rand -hex 16
WATI_WEBHOOK_KEY=replace-me
